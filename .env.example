# Copy to .env and fill in. NEVER commit .env.

# --- Database ---------------------------------------------------------------
# sqlite: single file at data/trading_data.db, no server needed (fine for a few
#         hundred symbols). postgresql: fill in the DB_* settings below.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_data
DB_USER=your_username
DB_PASSWORD=your_password

# --- Market data --------------------------------------------------------------
# Historical load (scripts/fetch_eod_historical.py): EOD Historical Data, eodhd.com
EOD_API_KEY=your_eodhd_key
# Daily updates (daily_update.py): Massive (formerly Polygon.io); free plan works
MARKET_API_KEY=your_massive_key
# MARKET_API_BASE_URL=https://api.massive.com

# --- Optional: email the daily orders (Gmail app password) ----------------------
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=you@gmail.com
