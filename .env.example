# Copy to .env and fill in. NEVER commit .env.

# --- Database ---------------------------------------------------------------
# sqlite: single file at data/trading_data.db, no server needed (fine for a few
#         hundred symbols). postgresql: fill in the DB_* settings below.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_data
DB_USER=your_username
DB_PASSWORD=your_password

# --- Market data --------------------------------------------------------------
# Tiingo (company list + adjusted daily prices): tiingo.com -> Account -> API.
# The Power plan is needed for the full load and daily updates.
TIINGO_API_KEY=your_tiingo_key
# SEC EDGAR (fundamentals, free): "Name email" - required by the SEC's fair-access policy
SEC_USER_AGENT=Your Name you@example.com

# --- Optional: email the daily orders (Gmail app password) ----------------------
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_TO=you@gmail.com
